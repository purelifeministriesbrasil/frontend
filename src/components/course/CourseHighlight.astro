---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { siteConfig } from "../../lib/site-config";

interface Props {
  /** Âncora/URL do botão "Conhecer a Grade" (na Home aponta para /curso/#grade). */
  gradeHref?: string;
  /** Usa <h1> quando a seção abre a página /curso/. */
  headingLevel?: "h1" | "h2";
}

const { gradeHref = "#grade", headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const { course } = siteConfig;

const highlights = [
  { value: course.durationLabel, label: "Duração total" },
  { value: course.modalityLabel, label: "Modalidade EAD" },
  { value: "MEC", label: "Certificado reconhecido" },
  { value: "SEBI + PLM", label: "Chancela institucional" },
];
---

<section id="curso" class="relative py-24 bg-[#1C2530] text-white overflow-hidden">
  <div class="absolute inset-0 course-glow pointer-events-none" aria-hidden="true"></div>
  <Container size="wide" class="relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7" data-reveal="from-left">
        <span class="inline-block border border-[#D99B26]/60 text-[#D99B26] font-montserrat text-[0.7rem] font-bold tracking-[0.18em] uppercase px-3 py-1.5 mb-6">
          Parceria Acadêmica • Reconhecido pelo MEC
        </span>

        <Heading class="font-ruda font-black text-white text-balance text-3xl sm:text-4xl lg:text-5xl leading-tight mb-6">
          Pós-Graduação em <span class="text-[#D99B26]">Aconselhamento Bíblico</span> e Distúrbios da Sexualidade
        </Heading>

        <p class="font-montserrat text-[#DEDEDE] text-base leading-relaxed mb-8 max-w-2xl">
          Capacitação teológica e clínica para pastores, líderes, conselheiros e cristãos que desejam atuar na linha de frente da restauração de famílias e indivíduos cativos pelo pecado sexual, através de uma abordagem 100% centrada na suficiência das Escrituras.
        </p>

        <div class="flex flex-wrap gap-4">
          <Button
            href={siteConfig.contact.courseWhatsapp.url}
            variant="primary"
            class="text-xs sm:text-sm px-6 py-3.5 uppercase tracking-wider font-bold"
            target="_blank"
            rel="noopener noreferrer"
          >
            Falar com Consultor Acadêmico
            <span class="sr-only"> (WhatsApp, abre em nova aba)</span>
          </Button>
          <Button href={gradeHref} variant="outline-light" class="text-xs sm:text-sm px-6 py-3.5 uppercase tracking-wider font-bold">
            Conhecer a Grade
          </Button>
        </div>
      </div>

      <ul class="lg:col-span-5 grid grid-cols-2 gap-4" data-reveal-group>
        {highlights.map((item) => (
          <li class="border border-[#C1BDA6]/30 bg-white/5 hover:border-[#D99B26] transition-colors duration-300 p-6" data-reveal>
            <div class="font-ruda font-black text-[#D99B26] text-2xl sm:text-3xl mb-2">{item.value}</div>
            <div class="font-montserrat text-[#DEDEDE] text-[0.7rem] font-bold uppercase tracking-[0.15em]">{item.label}</div>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>
