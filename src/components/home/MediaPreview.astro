---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";

const mediaVideos = [
  {
    title: "Testemunho: Paulo Gouvêa e Railca — IECBR Reaviva",
    speaker: "Pr. Paulo e Railca Gouvêa",
    youtubeId: "102MIhzXgWg",
    url: "https://youtu.be/102MIhzXgWg",
    tag: "Testemunho Real",
    type: "Testemunho",
  },
  {
    title: "1# Conferência da Família: Sexualidade e Identidade",
    speaker: "Pr. Paulo Gouvêa · Igreja Dókimos",
    youtubeId: "CLVe9MjGDeE",
    url: "https://www.youtube.com/watch?v=CLVe9MjGDeE",
    tag: "Conferência",
    type: "Conferência",
  },
  {
    title: "Conferência Reconstruir — MEVAM Curitiba",
    speaker: "Pr. Paulo Gouvêa",
    youtubeId: "AvyjLxzWLnA",
    url: "https://www.youtube.com/watch?v=AvyjLxzWLnA",
    tag: "Conferência",
    type: "Conferência",
  },
  {
    title: "No Topo da Pureza Sexual — Parte 1",
    speaker: "Pr. Paulo Gouvêa · Pure Life Ministries",
    youtubeId: "1Hw9toeuy50",
    url: "https://www.youtube.com/watch?v=1Hw9toeuy50",
    tag: "Série Especial",
    type: "Série Pureza",
  },
  {
    title: "Sexo: Criação de Deus ou do Homem?",
    speaker: "Pr. Paulo Gouvêa",
    youtubeId: "ZdT0pbwsNyM",
    url: "https://www.youtube.com/watch?v=ZdT0pbwsNyM",
    tag: "Estudo Bíblico",
    type: "Doutrina",
  },
  {
    title: "Distúrbios Sexuais — IDPB FilaCast #022",
    speaker: "Pr. Paulo Gouvêa",
    youtubeId: "IC-wYfQ-Ud0",
    url: "https://www.youtube.com/watch?v=IC-wYfQ-Ud0",
    tag: "Podcast",
    type: "Podcast",
  },
];
---

<section id="midias" class="py-24 bg-[#F5F2EC]">
  <Container size="wide">
    <div class="grid lg:grid-cols-12 gap-12 items-start mb-12">
      <!-- Coluna da Esquerda: Apresentação & Links Úteis -->
      <div class="lg:col-span-5">
        <SectionHeading
          tag="Mídias e Recursos"
          title="Pregações, palestras e testemunhos disponíveis no YouTube"
          description="Acesse mensagens bíblicas expositivas, conferências e testemunhos reais de restauração familiar e vitória sobre a escravidão sexual."
        />

        <div class="mb-8">
          <h3 class="font-ruda font-bold text-[#1C2530] text-lg mb-2">Mensagens Pastorais & Entrevistas</h3>
          <p class="font-montserrat text-[#575757] text-sm leading-relaxed mb-6">
            O Pr. Paulo Adriano Gouvêa compartilha a suficiência das Escrituras Sagradas em conferências e igrejas por todo o país. Assista gratuitamente aos conteúdos em nosso canal.
          </p>
        </div>

        <div class="flex flex-col gap-3 mb-8">
          <a
            href="https://www.youtube.com/@purelifeministriesbrasil"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-4 border border-[#044A82] bg-white hover:bg-[#044A82] text-[#044A82] hover:text-white transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md group"
          >
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6 text-[#FF0000] group-hover:text-white shrink-0 transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span class="font-montserrat font-bold text-sm">
                Inscrever-se no Canal do YouTube
              </span>
            </div>
            <span class="text-base font-bold group-hover:translate-x-1.5 transition-transform duration-300" aria-hidden="true">
              →
            </span>
          </a>

          <a
            href="/conferencia/"
            class="flex items-center justify-between p-4 border border-[#DEDEDE] bg-white hover:border-[#044A82] hover:bg-white hover:-translate-y-0.5 hover:shadow-xs transition-all duration-300 group"
          >
            <span class="font-montserrat font-semibold text-sm text-[#1C2530] group-hover:text-[#044A82] transition-colors">
              Mensagens da Conferência Anual
            </span>
            <span class="text-[#044A82] text-lg font-bold group-hover:translate-x-1.5 transition-transform duration-300" aria-hidden="true">
              →
            </span>
          </a>

          <a
            href="/editora/"
            class="flex items-center justify-between p-4 border border-[#DEDEDE] bg-white hover:border-[#044A82] hover:bg-white hover:-translate-y-0.5 hover:shadow-xs transition-all duration-300 group"
          >
            <span class="font-montserrat font-semibold text-sm text-[#1C2530] group-hover:text-[#044A82] transition-colors">
              Livros e Literatura Pastoral
            </span>
            <span class="text-[#044A82] text-lg font-bold group-hover:translate-x-1.5 transition-transform duration-300" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>

      <!-- Coluna da Direita: Grade de Vídeos com Thumbnails Reais -->
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-4" data-reveal-group>
        {
          mediaVideos.map((video) => (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="media-card group relative overflow-hidden bg-[#1C2530] flex flex-col justify-between"
              data-reveal
              aria-label={`Assistir no YouTube: ${video.title}`}
            >
              <!-- Thumbnail Wrapper -->
              <div class="relative aspect-video overflow-hidden bg-black">
                <img
                  src={`https://img.youtube.com/vi/${video.youtubeId}/hqdefault.jpg`}
                  alt={video.title}
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="360"
                  class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-108 transition-all duration-700 ease-out"
                />

                <!-- Play Button Badge -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="w-12 h-12 rounded-full bg-[#044A82]/90 text-white flex items-center justify-center backdrop-blur-xs group-hover:scale-120 group-hover:bg-[#FF0000] group-hover:shadow-[0_0_25px_rgba(255,0,0,0.55)] transition-all duration-300 shadow-md">
                    <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24" aria-hidden="true">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </div>
                </div>

                <!-- Video Tag Badge -->
                <div class="absolute top-2.5 left-2.5 z-10 pointer-events-none">
                  <span class="px-2 py-0.5 rounded-xs text-[0.65rem] font-montserrat uppercase font-bold tracking-wider bg-black/70 text-white backdrop-blur-xs group-hover:bg-[#044A82] transition-colors duration-300">
                    {video.tag}
                  </span>
                </div>
              </div>

              <!-- Metadata -->
              <div class="p-4 bg-white flex flex-col justify-between flex-1">
                <div>
                  <h4 class="font-ruda font-bold text-sm text-[#1C2530] group-hover:text-[#044A82] line-clamp-2 leading-snug mb-1 transition-colors duration-200">
                    {video.title}
                  </h4>
                  <span class="font-montserrat text-xs text-[#575757] block">
                    {video.speaker}
                  </span>
                </div>

                <div class="mt-3 pt-2.5 border-t border-[#DEDEDE] flex items-center justify-between text-xs text-[#044A82] font-semibold">
                  <span>Assistir no YouTube</span>
                  <span class="inline-block transform group-hover:translate-x-1.5 transition-transform duration-300 font-bold">↗</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- Banner Inferior com Mais Vídeos -->
    <div class="bg-white border border-[#DEDEDE] p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <h4 class="font-ruda font-bold text-lg text-[#1C2530] mb-1">
          Mais de 100 horas de conteúdo bíblico gratuito
        </h4>
        <p class="font-montserrat text-xs text-[#575757]">
          Inscreva-se em nosso canal e ative as notificações para receber novos estudos bíblicos, palestras e mensagens.
        </p>
      </div>
      <Button href="https://www.youtube.com/@purelifeministriesbrasil" variant="dark" class="shrink-0 text-xs">
        Acessar Canal Completo
      </Button>
    </div>
  </Container>
</section>
