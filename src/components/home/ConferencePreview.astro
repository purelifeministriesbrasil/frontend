---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import ConferenceThemeCard from "../conference/ConferenceThemeCard.astro";
import { Picture } from "astro:assets";
import conferenceImg from "../../assets/images/conference.webp";
---

<section id="conferencia" class="py-24 bg-[#1C2530] text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
    <Picture
      src={conferenceImg}
      alt=""
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      quality="mid"
      pictureAttributes={{ class: "contents" }}
      widths={[480, 700]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#1C2530] via-[#1C2530]/85 to-transparent"></div>
  </div>

  <Container size="wide" class="relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div data-reveal="from-left">
        <span class="font-montserrat text-[#C1BDA6] text-xs font-bold tracking-[0.15em] uppercase block mb-4">
          Conferência Anual Pure Life Ministries Brasil
        </span>
        <h2 class="font-ruda font-black text-white text-balance text-3xl sm:text-4xl lg:text-5xl mb-6 leading-tight">
          O maior encontro de aconselhamento bíblico de Brasília
        </h2>

        <ul class="flex flex-wrap gap-3 mb-6" aria-label="Data e local da 2ª edição">
          <li class="inline-flex items-center gap-2.5 border border-[#C1BDA6]/45 bg-[#1C2530]/70 px-4 py-2.5">
            <span class="font-ruda font-black text-[#C1BDA6] text-base">2ª Edição</span>
            <span class="font-montserrat text-white text-sm font-semibold">· 28 e 29 de maio de 2027</span>
          </li>
          <li class="inline-flex items-center gap-2.5 border border-[#C1BDA6]/45 bg-[#1C2530]/70 px-4 py-2.5">
            <span class="font-montserrat text-white text-sm font-semibold">Brasília – DF</span>
          </li>
        </ul>

        <p class="font-montserrat text-[#DEDEDE] text-sm sm:text-base leading-relaxed mb-8 max-w-xl">
          Dias intensos de ensino bíblico, adoração e comunhão para pastores, conselheiros, líderes e famílias. A programação e a abertura de inscrições serão anunciadas pelos canais oficiais do ministério.
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4">
          <Button href="/conferencia/" variant="primary" class="text-xs px-6 py-3.5 text-center">
            Página da Conferência
          </Button>
          <Button href="/contato/?assunto=Conferencia" variant="outline-light" class="text-xs px-6 py-3.5 text-center">
            Avise-me sobre 2027
          </Button>
        </div>
      </div>

      <div data-reveal="from-right">
        <ConferenceThemeCard size="md" />
      </div>
    </div>
  </Container>
</section>
