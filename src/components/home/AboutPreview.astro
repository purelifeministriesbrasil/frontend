---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { siteConfig } from "../../lib/site-config";

const [lead, ...rest] = siteConfig.aboutParagraphs;
const leadBody = lead.replace(siteConfig.name, "");
import { Picture } from "astro:assets";
import aboutImg from "../../assets/images/about.webp";
---

<section id="sobre" class="py-24 bg-[#F5F2EC]">
  <Container size="wide">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Imagem Institucional e Moldura -->
      <div class="relative" data-reveal="from-left">
        <div class="relative z-10 overflow-hidden shadow-lg border border-[#DEDEDE] card-lift">
          <Picture
            src={aboutImg}
            alt="Grupo de homens reunido em círculo para estudo bíblico no salão do campus, com uma cruz de madeira na parede"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality="mid"
            pictureAttributes={{ class: "contents" }}
            widths={[480, 700]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            loading="lazy"
            decoding="async"
            class="w-full h-[400px] sm:h-[480px] lg:h-[520px] object-cover"
          />
        </div>
        <div class="absolute -bottom-6 -right-6 w-48 h-48 bg-[#3B4C60]/10 border border-[#3B4C60]/20 z-0 hidden sm:block float-slow"></div>
        <div class="absolute -top-6 -left-6 w-24 h-24 bg-[#044A82]/10 border border-[#044A82]/20 z-0 hidden sm:block"></div>
        <div class="absolute bottom-8 -right-2 sm:-right-4 bg-[#1C2530] text-white px-6 py-4 z-20 shadow-md">
          <div class="font-ruda font-black text-3xl text-[#C1BDA6]">1986</div>
          <div class="font-montserrat text-xs uppercase tracking-[0.15em] text-[#DEDEDE]">Fundada em</div>
        </div>
      </div>

      <!-- Texto Institucional -->
      <div data-reveal="from-right">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-0.5 bg-[#044A82]"></div>
          <span class="font-montserrat text-[#044A82] text-xs font-bold tracking-[0.15em] uppercase">
            Quem Somos
          </span>
        </div>

        <h2 class="font-ruda font-black text-[#1C2530] leading-tight mb-6 text-balance text-3xl sm:text-4xl lg:text-5xl">
          Uma instituição construída sobre a Palavra
        </h2>

        <p class="font-montserrat text-[#1C2530] leading-relaxed mb-5 text-base">
          <strong class="font-semibold text-[#044A82]">{siteConfig.name}</strong>{leadBody}
        </p>

        {rest.map((paragraph, index) => (
          <p class={`font-montserrat text-[#575757] leading-relaxed text-sm sm:text-base ${index === rest.length - 1 ? "mb-8" : "mb-5"}`}>
            {paragraph}
          </p>
        ))}

        <!-- Métricas Responsivas (Piso WCAG e grid flexível) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8 py-6 border-t border-b border-[#DEDEDE]" data-reveal-group>
          <div data-reveal>
            <div
              class="font-ruda font-black text-[#044A82] text-3xl"
              data-count-up="40"
              data-count-prefix="+"
            >+40</div>
            <div class="font-montserrat text-[#575757] text-xs leading-snug mt-1 font-medium">Anos de ministério</div>
          </div>
          <div data-reveal>
            <div
              class="font-ruda font-black text-[#044A82] text-3xl"
              data-count-up="2000"
              data-count-prefix="+"
            >+2.000</div>
            <div class="font-montserrat text-[#575757] text-xs leading-snug mt-1 font-medium">Vidas restauradas</div>
          </div>
          <div data-reveal>
            <div
              class="font-ruda font-black text-[#044A82] text-3xl"
              data-count-up="6"
            >6</div>
            <div class="font-montserrat text-[#575757] text-xs leading-snug mt-1 font-medium">Conselheiros certificados</div>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <Button href="/sobre/" variant="dark">
            Conheça nossa história
          </Button>
          <Button href="/programas/" variant="outline">
            Ver programas
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
