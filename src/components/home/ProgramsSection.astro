---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ProgramCard from "../programs/ProgramCard.astro";
import ProgramProcess from "../programs/ProgramProcess.astro";
import { programs } from "../../data/programs";
---

<section id="programas" class="py-24 bg-[#F5F2EC]">
  <Container size="wide">
    <SectionHeading
      tag="Nossos Programas"
      title="Caminhos de restauração fundamentados nas Escrituras"
      description="Oferecemos modalidades presenciais e remotas desenvolvidas para atender as diferentes realidades e estágios de vida."
      align="center"
    />

    <div class="grid md:grid-cols-2 gap-8 mb-20 max-w-6xl mx-auto">
      {programs.map((program) => (
        <ProgramCard
          badge={program.badge}
          badgeVariant={program.badgeVariant}
          title={program.title}
          subtitle={program.subtitle}
          description={program.description}
          features={program.features}
          imageSrc={program.imageSrc}
          imageAlt={program.imageAlt}
          leaderName={program.leaderName}
          ctaText={program.ctaText}
          ctaHref={program.ctaHref}
          ctaExternal={program.ctaExternal}
          secondaryCtaText={program.secondaryCtaText}
          secondaryCtaHref={program.secondaryCtaHref}
        />
      ))}
    </div>

    <!-- Jornada do Processo -->
    <ProgramProcess />
  </Container>
</section>
