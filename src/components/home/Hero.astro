---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
---

<section id="hero" class="relative min-h-[90vh] flex items-end pb-24 overflow-hidden bg-[#1C2530] text-white">
  <!-- Imagem Local Otimizada com fetchpriority="high" (§3.4, §3.5) -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/hero.webp"
      alt="Bíblia aberta sob iluminação solene"
      width="1920"
      height="1080"
      fetchpriority="high"
      class="w-full h-full object-cover opacity-45 scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#1C2530] via-[#1C2530]/70 to-[#1C2530]/30" />
  </div>

  <!-- Distintivo Lateral Desktop -->
  <div class="absolute left-8 top-1/2 -translate-y-1/2 hidden 2xl:flex flex-col items-center gap-3 z-10" aria-hidden="true">
    <div class="w-px h-16 bg-[#C1BDA6]/30"></div>
    <span class="font-editorial text-[#C1BDA6]/70 text-xs [writing-mode:vertical-rl] tracking-[0.25em]">
      EST. 1986
    </span>
    <div class="w-px h-16 bg-[#C1BDA6]/30"></div>
  </div>

  <Container size="wide" class="relative z-10">
    <div class="max-w-3xl">
      <!-- Tag de Abertura -->
      <div class="flex items-center gap-3 mb-6">
        <div class="w-12 h-0.5 bg-[#C1BDA6]"></div>
        <span class="font-editorial text-[#C1BDA6] text-sm sm:text-base tracking-[0.18em]">
          Escola de Aconselhamento Bíblico Cristão Reformado
        </span>
      </div>

      <!-- Título Principal -->
      <h1 class="font-ruda font-black text-white text-balance text-4xl sm:text-5xl lg:text-6xl leading-[1.08] mb-6">
        Uma vida de pureza começa com uma vida{" "}
        <span class="text-[#C1BDA6] font-normal italic font-editorial">rendida a Cristo.</span>
      </h1>

      <!-- Subtítulo -->
      <p class="font-montserrat text-[#DEDEDE] text-lg sm:text-xl font-light leading-relaxed mb-6 max-w-2xl">
        Há mais de quatro décadas, liderando cristãos à transformação genuína por meio do aconselhamento bíblico e da graça soberana de Deus.
      </p>

      <!-- Destaque 40 anos -->
      <div class="flex items-center gap-4 mb-8">
        <div class="border border-[#C1BDA6]/40 bg-[#1C2530]/60 backdrop-blur-xs px-5 py-2.5 inline-flex items-center gap-3">
          <span class="font-ruda font-black text-[#C1BDA6] text-2xl sm:text-3xl">+40</span>
          <span class="font-montserrat text-[#DEDEDE] text-xs uppercase tracking-[0.12em]">Anos de ministério</span>
        </div>
      </div>

      <!-- Ações Principais -->
      <div class="flex flex-wrap items-center gap-4">
        <Button href="/programas/" variant="primary" class="text-xs sm:text-sm px-7 py-4">
          Conheça nossos programas
        </Button>
        <Button href="/triagem/" variant="outline-light" class="text-xs sm:text-sm px-7 py-4">
          Pedir ajuda confidencial
        </Button>
      </div>

      <!-- Lema do Ministério -->
      <p class="font-editorial text-[#C1BDA6]/80 text-sm sm:text-base mt-8 tracking-widest italic">
        "Liderando Cristãos à Pureza desde 1986!"
      </p>
    </div>
  </Container>
</section>
