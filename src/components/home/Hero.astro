---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
---

<section id="hero" class="relative -mt-16 sm:-mt-20 min-h-[100dvh] flex flex-col justify-start pt-24 sm:pt-28 lg:pt-30 pb-6 sm:pb-8 overflow-hidden bg-[#1C2530] text-white">
  <!-- Imagem Local Otimizada com fetchpriority="high" (§3.4, §3.5) -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/hero.webp"
      alt="Bíblia aberta sob iluminação solene"
      width="1920"
      height="1080"
      fetchpriority="high"
      class="hero-img w-full h-full object-cover opacity-45 scale-105"
    />
    <div class="hero-overlay absolute inset-0"></div>
  </div>

  <!-- Distintivo Lateral Desktop -->
  <div class="absolute left-8 top-1/2 -translate-y-1/2 hidden 2xl:flex flex-col items-center gap-3 z-10 float-slow" aria-hidden="true">
    <div class="w-px h-16 bg-[#C1BDA6]/30"></div>
    <span class="font-editorial text-[#C1BDA6]/70 text-xs [writing-mode:vertical-rl] tracking-[0.25em]">
      EST. 1986
    </span>
    <div class="w-px h-16 bg-[#C1BDA6]/30"></div>
  </div>

  <Container size="wide" class="relative z-10">
    <div class="max-w-3xl">
      <!-- Tag de Abertura -->
      <div class="hero-animate-1 flex items-center gap-3 mb-2 sm:mb-2.5 group cursor-default">
        <div class="w-10 sm:w-12 h-0.5 bg-[#C1BDA6] group-hover:w-16 transition-all duration-300"></div>
        <span class="font-editorial text-[#C1BDA6] text-xs sm:text-sm tracking-[0.18em]">
          Escola de Aconselhamento Bíblico Cristão Reformado
        </span>
      </div>

      <!-- Título Principal -->
      <h1 class="hero-animate-2 font-ruda font-black text-white text-balance text-2xl sm:text-3xl md:text-4xl lg:text-[2.85rem] leading-[1.12] mb-3 sm:mb-3.5">
        Uma vida de pureza começa com uma vida{" "}
        <span class="text-[#C1BDA6] font-normal italic font-editorial">rendida a Cristo.</span>
      </h1>

      <!-- Subtítulo -->
      <p class="hero-animate-3 font-montserrat text-[#DEDEDE] text-sm sm:text-base lg:text-[1.05rem] font-light leading-relaxed mb-3 sm:mb-3.5 max-w-2xl">
        Há mais de quatro décadas, liderando cristãos à transformação genuína por meio do aconselhamento bíblico e da graça soberana de Deus.
      </p>

      <!-- Destaque 40 anos -->
      <div class="hero-animate-4 flex items-center gap-4 mb-3.5 sm:mb-4">
        <div class="border border-[#C1BDA6]/40 bg-[#1C2530]/75 hover:bg-[#1C2530] hover:border-[#C1BDA6] hover:shadow-[0_0_20px_rgba(193,189,166,0.18)] hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-xs px-3.5 py-1.5 sm:px-4 sm:py-2 inline-flex items-center gap-3 cursor-default group">
          <span class="font-ruda font-black text-[#C1BDA6] text-lg sm:text-xl group-hover:scale-105 transition-transform duration-300">+40</span>
          <span class="font-montserrat text-[#DEDEDE] group-hover:text-white text-[0.68rem] sm:text-xs uppercase tracking-[0.12em] transition-colors duration-200">Anos de ministério</span>
        </div>
      </div>

      <!-- Ações Principais -->
      <div class="hero-animate-5 flex flex-wrap items-center gap-3 sm:gap-4">
        <Button href="/programas/" variant="primary" class="text-xs sm:text-sm px-5 sm:px-6 py-2.5 sm:py-3 shadow-md hover:shadow-lg transition-all duration-200">
          Conheça nossos programas
        </Button>
        <Button href="/triagem/" variant="outline-light" class="text-xs sm:text-sm px-5 sm:px-6 py-2.5 sm:py-3">
          Pedir ajuda confidencial
        </Button>
      </div>

      <!-- Lema do Ministério -->
      <p class="hero-animate-5 font-editorial text-[#C1BDA6]/80 text-xs sm:text-sm mt-3 sm:mt-3.5 tracking-widest italic">
        "Liderando Cristãos à Pureza desde 1986!"
      </p>
    </div>
  </Container>

  <!-- Indicador de Rolagem Animado (responsivo para mobile, tablet e desktop) -->
  <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 md:bottom-8 md:right-8 flex flex-col items-center gap-1.5 opacity-75 hover:opacity-100 transition-opacity z-10 select-none pointer-events-none" aria-hidden="true">
    <span class="font-montserrat text-[#DEDEDE] text-[0.55rem] sm:text-[0.6rem] tracking-[0.25em] uppercase font-semibold">Role</span>
    <div class="w-px h-6 sm:h-7 md:h-8 bg-[#C1BDA6]/40 relative overflow-hidden">
      <div class="absolute inset-0 bg-[#C1BDA6] animate-bounce origin-top scroll-indicator-bar"></div>
    </div>
  </div>
</section>
