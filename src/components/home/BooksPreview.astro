---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";

const featuredBooks = [
  {
    title: "No Altar da Idolatria Sexual",
    author: "Steve Gallagher",
    price: "R$ 65,00",
    audience: "Homens",
    desc: "Obra clássica que trata as raízes espirituais do pecado sexual e o caminho bíblico para a libertação.",
    accentColor: "border-[#044A82]",
    badgeBg: "bg-[#044A82]/10 text-[#044A82]",
    bgColor: "bg-[#1C2530]",
  },
  {
    title: "Cria em Mim um Coração Puro",
    author: "Kathy Gallagher",
    price: "R$ 55,00",
    audience: "Mulheres",
    desc: "Guia profundo que trata o pecado sexual feminino com graça, verdade e restauração bíblica.",
    accentColor: "border-[#3B4C60]",
    badgeBg: "bg-[#3B4C60]/10 text-[#3B4C60]",
    bgColor: "bg-[#3B4C60]",
  },
  {
    title: "O Impacto Pessoal e Social da Pornografia",
    author: "Pr. Paulo Adriano Gouvêa",
    price: "R$ 45,00",
    audience: "Todos os Públicos",
    desc: "Análise bíblica e pastoral sobre como o consumo de pornografia destrói o indivíduo, a família e a igreja.",
    accentColor: "border-[#044A82]",
    badgeBg: "bg-[#044A82]/10 text-[#044A82]",
    bgColor: "bg-[#044A82]",
  },
  {
    title: "As 20 Verdades Contra o Vício em Pornografia",
    author: "Steve Gallagher",
    price: "R$ 75,00",
    audience: "Homens, Mulheres e Jovens",
    desc: "Devocional prático com 20 princípios bíblicos essenciais para vencer as tentações diárias e perseverar na pureza.",
    accentColor: "border-[#454A50]",
    badgeBg: "bg-[#454A50]/10 text-[#454A50]",
    bgColor: "bg-[#454A50]",
  },
];
---

<section id="editora" class="py-24 bg-[#F5F2EC]">
  <Container size="wide">
    <SectionHeading
      tag="Editora e Livraria Pure Life"
      title="Literatura que transforma pela verdade das Escrituras"
      description="Publicamos e distribuímos obras fundamentais para o aconselhamento bíblico, santidade cristã e restauração de lares à luz da tradição reformada."
      align="center"
    />

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12" data-reveal-group>
      {
        featuredBooks.map((book) => (
          <div class="book-card group flex flex-col justify-between" data-reveal>
            <!-- Hardcover Book Mockup with 3D Spine and Shimmer -->
            <div class={`book-cover relative h-52 flex flex-col justify-between p-5 ${book.bgColor}`}>
              <div class="book-spine-crease"></div>
              <div class="book-cover-shimmer"></div>
              <div class="absolute right-0 top-0 bottom-0 w-1.5 bg-gradient-to-l from-white/20 to-transparent pointer-events-none"></div>

              <div class="flex justify-between items-start z-10">
                <span class="font-montserrat text-[0.68rem] uppercase font-bold tracking-wider px-2 py-0.5 rounded-xs bg-white/20 text-white backdrop-blur-xs group-hover:scale-105 group-hover:bg-white/30 transition-all duration-300">
                  {book.audience}
                </span>
                <span class="font-ruda font-bold text-white text-base bg-black/25 px-2.5 py-0.5 rounded-xs border border-white/15 group-hover:border-white/40 group-hover:scale-105 transition-all duration-300 shadow-xs">
                  {book.price}
                </span>
              </div>

              <div class="relative z-10">
                <h4 class="font-ruda font-black text-white text-lg leading-snug group-hover:translate-x-1.5 transition-transform duration-300 drop-shadow-xs">
                  {book.title}
                </h4>
              </div>

              <!-- Decorative dynamic geometric shapes on hover -->
              <div class="absolute -right-6 -bottom-6 w-32 h-32 rounded-full bg-white/5 pointer-events-none group-hover:scale-150 group-hover:rotate-45 transition-transform duration-700 ease-out"></div>
              <div class="absolute -left-4 -top-4 w-20 h-20 rounded-full bg-black/10 pointer-events-none group-hover:scale-125 transition-transform duration-700 ease-out"></div>
            </div>

            <!-- Book Details Body -->
            <div class="p-5 flex flex-col justify-between flex-1 bg-white">
              <div>
                <span class="font-montserrat text-[#044A82] text-[0.7rem] uppercase tracking-widest block mb-2 font-bold group-hover:text-[#033863] transition-colors">
                  {book.author}
                </span>
                <p class="font-montserrat text-[#454A50] text-xs leading-relaxed">
                  {book.desc}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-[#DEDEDE] flex items-center justify-between">
                <span class="font-ruda font-black text-[#1C2530] text-base group-hover:text-[#044A82] transition-colors">
                  {book.price}
                </span>
                <a
                  href="/editora/"
                  class="font-montserrat text-[0.72rem] font-bold uppercase tracking-wider text-[#044A82] group-hover:text-[#1C2530] transition-colors inline-flex items-center gap-1.5"
                >
                  <span>Ver no Catálogo</span>
                  <span class="inline-block transform group-hover:translate-x-1.5 transition-transform duration-300 font-black">→</span>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center flex flex-col sm:flex-row justify-center items-center gap-4">
      <Button href="/editora/" variant="dark">
        Ver catálogo editorial completo (9 livros)
      </Button>
      <Button href="/contato/?assunto=Editora" variant="outline">
        Pedidos para igrejas e livrarias
      </Button>
    </div>
  </Container>
</section>
