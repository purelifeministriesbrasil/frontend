---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { siteConfig, whatsappUrl } from "../../lib/site-config";

const tripWhatsAppUrl = whatsappUrl(
  siteConfig.contact.whatsapp.number,
  "Olá! Tenho interesse na Viagem Pure Life Ministries aos EUA (Cincinnati, Ohio & Kentucky). Gostaria de informações sobre lotes, investimento e visto."
);
---

<section id="viagem" class="py-24 bg-[#1C2530] text-white relative overflow-hidden">
  <Container size="wide">
    <div class="text-center mb-16 max-w-3xl mx-auto" data-reveal>
      <span class="font-montserrat text-[#C1BDA6] text-xs font-bold tracking-[0.15em] uppercase block mb-4">
        Viagem PLM aos EUA
      </span>
      <h2 class="font-ruda font-black text-white text-balance text-3xl sm:text-4xl lg:text-5xl mb-6">
        Conheça a sede da Pure Life Ministries Internacional
      </h2>
      <p class="font-montserrat text-[#DEDEDE] text-base sm:text-lg leading-relaxed mb-6">
        Uma experiência de imersão em Cincinnati, Ohio & Kentucky, com visita ao campus internacional da Pure Life Ministries em Kentucky — a fonte do ministério que inspirou a PLM Brasil.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <div data-reveal="from-left">
        <h3 class="font-ruda font-bold text-white text-2xl mb-4">Sobre a Viagem</h3>
        <p class="font-montserrat text-[#DEDEDE] text-sm sm:text-base leading-relaxed mb-5">
          A <strong class="text-white font-semibold">Viagem PLM aos EUA</strong> é organizada pela Pure Life Ministries Brasil para pastores, líderes, conselheiros e cristãos interessados em conhecer pessoalmente o campus e o modelo comprovado por quatro décadas de ministério.
        </p>
        <p class="font-montserrat text-[#DEDEDE] text-sm sm:text-base leading-relaxed mb-8">
          A programação combina a imersão no campus internacional da Pure Life Ministries em Kentucky com atividades na região de Cincinnati, Ohio. Os participantes visitam as instalações residenciais, participam de ministrações com a liderança sênior e vivenciam de perto o rigor bíblico e o acolhimento pastoral que caracterizam a obra internacional.
        </p>

        <div class="flex flex-col gap-3 mb-8">
          {
            [
              "Visita ao campus internacional da Pure Life Ministries em Kentucky",
              "Atividades e programação na região de Cincinnati, Ohio",
              "Ensinamentos com a equipe de liderança americana",
              "Participação em sessões e dinâmicas do programa",
              "Comunhão com a equipe e ex-participantes do programa",
              "Vivência da cultura e espiritualidade do ministério",
            ].map((item) => (
              <div class="flex items-start gap-3">
                <svg class="w-4 h-4 text-[#C1BDA6] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="font-montserrat text-[#DEDEDE] text-sm">{item}</span>
              </div>
            ))
          }
        </div>

        <div class="flex flex-wrap gap-4">
          <Button href="/viagem-eua/" variant="primary">
            Ver detalhes da viagem
          </Button>
          <Button href={tripWhatsAppUrl} variant="outline-light" target="_blank" rel="noopener noreferrer">
            Inscrição e dúvidas pelo WhatsApp
            <span class="sr-only"> (abre em nova aba)</span>
          </Button>
        </div>
      </div>

      <div class="space-y-6" data-reveal="from-right">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-reveal-group>
          {
            [
              { label: "Destino", val: "Cincinnati, Ohio & Kentucky – EUA" },
              { label: "Programação", val: "Imersão no campus em Kentucky e atividades em Ohio" },
              { label: "Lotes e investimento", val: "Valores por lote informados pela equipe no WhatsApp" },
              { label: "Inscrição e visto", val: `Orientação pelo WhatsApp ${siteConfig.contact.whatsapp.display}` },
            ].map((d) => (
              <div class="pillar-card border border-[#3B4C60] bg-[#1C2530]/80 p-6 cursor-default group" data-reveal>
                <div class="font-montserrat text-[#C1BDA6] group-hover:text-white text-xs uppercase tracking-widest font-semibold mb-2 transition-colors duration-300">
                  {d.label}
                </div>
                <div class="font-ruda font-bold text-white text-base leading-snug">{d.val}</div>
              </div>
            ))
          }
        </div>

        <div class="pillar-card border border-[#3B4C60]/60 p-6 bg-white/5 cursor-default" data-reveal>
          <h4 class="font-ruda font-bold text-white text-base mb-3">Para quem é indicada?</h4>
          <ul class="flex flex-col gap-2.5 font-montserrat text-xs text-[#DEDEDE]">
            <li>• Pastores e presbíteros que desejam implementar aconselhamento bíblico em suas igrejas</li>
            <li>• Conselheiros bíblicos em formação ou em atividade pastoral</li>
            <li>• Líderes de ministérios de restauração e discipulado</li>
            <li>• Antigos participantes do programa que desejam aprofundar sua formação</li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
