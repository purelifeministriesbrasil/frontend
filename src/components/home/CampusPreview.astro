---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
---

<section id="campus" class="py-24 bg-white">
  <Container size="wide">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div data-reveal="from-left">
        <SectionHeading
          tag="Campus PLM Brasil"
          title="Conheça nosso Campus Residencial"
          description="Convidamos igrejas, grupos de pastores e líderes para visitar o campus residencial em Águas Lindas de Goiás – GO, a aproximadamente 50 km de Brasília. Conheça as instalações, participe de um dia de imersão e aconselhamento, reúna-se com a equipe e leve para sua comunidade a visão da PLM Brasil."
        />

        <p class="font-montserrat text-[#575757] text-sm leading-relaxed mb-8">
          As visitas são organizadas para grupos de até 10 pessoas, mediante agendamento prévio com a equipe do ministério.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10" data-reveal-group>
          {
            [
              { label: "Visita ao campus", href: "/campus/", desc: "Instalações & Acomodações" },
              { label: "Reunião pastoral", href: "/contato/?assunto=Reuni%C3%A3o+Pastoral", desc: "Alinhamento com a Liderança" },
              { label: "Dia de imersão", href: "/contato/?assunto=Dia+de+Imers%C3%A3o", desc: "Aconselhamento Intensivo" }
            ].map((item) => (
              <a
                href={item.href}
                class="campus-pill group relative border border-[#DEDEDE] bg-[#F5F2EC] hover:bg-white hover:border-[#044A82] p-4 sm:p-5 text-center block overflow-hidden cursor-pointer shadow-2xs"
                data-reveal
              >
                <!-- Top accent border animation -->
                <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#044A82] scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left" />
                <span class="font-montserrat text-[#1C2530] group-hover:text-[#044A82] text-xs font-bold uppercase tracking-wider block transition-colors duration-300">
                  {item.label}
                </span>
                <span class="font-montserrat text-[#575757] text-[0.7rem] block mt-1.5 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
                  {item.desc}
                </span>
              </a>
            ))
          }
        </div>

        <div class="flex flex-wrap gap-4">
          <Button href="/campus/" variant="dark">
            Ver detalhes do campus
          </Button>
          <Button href="/contato/" variant="outline">
            Agendar visita
          </Button>
        </div>
      </div>

      <div class="relative group" data-reveal="from-right">
        <div class="overflow-hidden border border-[#DEDEDE] shadow-md card-lift">
          <img
            src="/images/campus.webp"
            alt="Campus Residencial PLM Brasil em Águas Lindas de Goiás"
            width="700"
            height="520"
            loading="lazy"
            decoding="async"
            class="w-full h-[360px] sm:h-[420px] object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
          />
        </div>
        <div class="absolute bottom-6 left-6 bg-[#1C2530] text-white px-5 py-4 shadow-lg group-hover:translate-x-1 transition-transform duration-300">
          <div class="font-ruda font-bold text-[#C1BDA6] text-sm">Águas Lindas de Goiás</div>
          <div class="font-montserrat text-xs uppercase tracking-widest text-[#DEDEDE] mt-0.5">Goiás, Brasil</div>
        </div>
      </div>
    </div>
  </Container>
</section>
