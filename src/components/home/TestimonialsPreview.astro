---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { testimonials } from "../../data/testimonials";

---

<section id="testemunhos" class="py-24 bg-white">
  <Container size="wide">
    <SectionHeading
      tag="Testemunhos"
      title="Um legado de transformações"
      description="Essas histórias poderosas lhe darão esperança. O que parece impossível para você é realmente possível para Deus."
    />

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-8" data-reveal-group>
      {
        testimonials.map((t) => (
          <div class="border border-[#DEDEDE] hover:border-[#044A82] p-8 sm:p-10 bg-[#F5F2EC]/40 hover:bg-white flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg group" data-reveal>
            <div>
              <div class="text-[#044A82] font-editorial text-4xl mb-3 leading-none select-none inline-block group-hover:scale-115 transition-transform duration-300" aria-hidden="true">
                “
              </div>
              <blockquote class="font-montserrat text-[#1C2530] text-sm sm:text-base leading-relaxed mb-6 italic">
                {t.text}
              </blockquote>
            </div>

            <div class="border-t border-[#DEDEDE] pt-4">
              <div class="font-ruda font-bold text-[#1C2530] text-sm group-hover:text-[#044A82] transition-colors">{t.name}</div>
              {t.location && <div class="font-montserrat text-[#575757] text-xs uppercase tracking-wider">{t.location}</div>}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
