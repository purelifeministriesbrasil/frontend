---
interface Props {
  policyVersion?: string;
}

const { policyVersion = "2026-09-19" } = Astro.props;
---

<div class="w-full max-w-md mx-auto">
  <div id="newsletter-feedback" class="hidden mb-4" role="status" aria-live="polite"></div>

  <form method="post" action="/api/forms/newsletter" class="newsletter-form flex flex-col sm:flex-row gap-3">
    <div class="flex-1">
      <label for="nl-email" class="sr-only">Seu e-mail</label>
      <input
        id="nl-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="Seu melhor e-mail"
        class="form-input w-full bg-white text-[#1C2530] text-sm py-3 px-4"
      />
    </div>

    <!-- Honeypot oculto via CSS (§7.6) -->
    <div class="hp-field" aria-hidden="true">
      <label for="nl-website">Não preencha este campo</label>
      <input id="nl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="policyVersion" value={policyVersion} />

    <button type="submit" class="btn-primary shrink-0 whitespace-nowrap text-xs font-bold px-6 py-3">
      Inscrever-se
    </button>
  </form>
</div>

<script>
  import "./newsletter-enhance.ts";
</script>
