---
import Navigation from "./Navigation.astro";
import Button from "../ui/Button.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
---

<header id="main-header" class="sticky top-0 z-50 bg-[#1C2530] border-b border-[#3B4C60]/40 text-white transition-all duration-300">
  <div class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4">
    <!-- Brand Logo Oficial -->
    <a href="/" class="flex items-center gap-3 shrink-0 focus-visible:ring-2 focus-visible:ring-[#D99B26] p-1 group opacity-95 hover:opacity-100 transition-opacity" aria-label="Pure Life Ministries Brasil - Página inicial">
      <img src="/images/PLM_Logo.png" alt="PLM símbolo" class="h-10 sm:h-12 w-auto object-contain" />
      <div class="flex flex-col">
        <span class="font-ruda font-black text-base sm:text-lg tracking-wider text-white uppercase leading-none">Pure Life</span>
        <span class="font-montserrat text-[0.6rem] sm:text-[0.65rem] tracking-[0.2em] text-[#C1BDA6] uppercase mt-0.5">Ministries Brasil</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden xl:flex items-center gap-4 2xl:gap-6 min-w-0">
      <Navigation currentPath={currentPath} />
    </div>

    <!-- Desktop Actions -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <a
        href="/doar/"
        class="font-montserrat text-xs uppercase tracking-wider font-bold text-[#C1BDA6] hover:text-white px-3 py-2 transition-colors"
      >
        Doar
      </a>
      <Button href="/triagem/" variant="primary" class="text-xs px-5 py-2.5">
        Inscreva-se
      </Button>
    </div>

    <!-- Mobile Hamburger Trigger -->
    <button
      id="mobile-menu-trigger"
      type="button"
      class="xl:hidden p-2 text-white hover:text-[#C1BDA6] focus-visible:outline-2 focus-visible:outline-[#D99B26] rounded"
      aria-label="Abrir menu de navegação"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="mobile-menu-dialog"
    >
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Native HTML5 Dialog for Mobile Navigation -->
  <dialog
    id="mobile-menu-dialog"
    class="xl:hidden fixed inset-0 m-0 w-full h-full max-w-none max-h-none bg-[#1C2530] text-white p-6 border-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
    aria-label="Menu de navegação móvel"
  >
    <div class="flex flex-col h-full justify-between max-w-md mx-auto">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-[#3B4C60]/40">
          <div class="flex items-center gap-3">
            <img src="/images/PLM_Logo.png" alt="Pure Life Ministries" class="h-10 w-auto object-contain" />
            <div class="flex flex-col">
              <span class="font-ruda font-black text-base tracking-wider text-white uppercase leading-none">Pure Life</span>
              <span class="font-montserrat text-[0.6rem] tracking-[0.2em] text-[#C1BDA6] uppercase mt-0.5">Ministries Brasil</span>
            </div>
          </div>
          <button
            id="mobile-menu-close"
            type="button"
            class="p-2 text-white hover:text-[#C1BDA6] focus-visible:outline-2 focus-visible:outline-[#D99B26] rounded"
            aria-label="Fechar menu de navegação"
          >
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="py-8">
          <Navigation currentPath={currentPath} isMobile={true} />
        </div>
      </div>

      <div class="flex flex-col gap-4 pt-6 border-t border-[#3B4C60]/40 pb-8">
        <Button href="/triagem/" variant="primary" class="w-full text-center py-3">
          Obter Ajuda Confidencial
        </Button>
        <Button href="/doar/" variant="outline-light" class="w-full text-center py-3">
          Fazer uma Doação
        </Button>
      </div>
    </div>
  </dialog>
</header>

<script>
  import "./mobile-nav.ts";

  const header = document.getElementById("main-header");
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 50) {
        header.classList.add("nav-scrolled");
      } else {
        header.classList.remove("nav-scrolled");
      }
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }
</script>
