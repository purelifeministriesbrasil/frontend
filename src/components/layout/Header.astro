---
import Navigation from "./Navigation.astro";
import Button from "../ui/Button.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
---

<header id="main-header" class="sticky top-0 z-50 bg-[#1C2530]/95 backdrop-blur-md border-b border-[#3B4C60]/40 text-white transition-all duration-300 will-change-transform shadow-sm">
  <div id="header-container" class="max-w-[90rem] mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-4 transition-all duration-300">
    <!-- Brand Logo Oficial (Símbolo limpo sem letras, com proporção áurea) -->
    <a href="/" class="flex items-center shrink-0 focus-visible:ring-2 focus-visible:ring-[#D99B26] p-1 group transition-all duration-300 hover:scale-105 active:scale-95" aria-label="Pure Life Ministries Brasil - Página inicial">
      <img src="/images/PLM_Logo.png" alt="Pure Life Ministries Brasil" class="h-9 sm:h-11 w-auto object-contain transition-all duration-300 group-hover:drop-shadow-[0_0_12px_rgba(217,155,38,0.35)]" />
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden xl:flex items-center gap-4 2xl:gap-6 min-w-0">
      <Navigation currentPath={currentPath} />
    </div>

    <!-- Desktop Actions -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <a
        href="/doar/"
        class="font-montserrat text-xs uppercase tracking-wider font-bold text-[#C1BDA6] hover:text-white px-3 py-2 transition-colors duration-200"
      >
        Doar
      </a>
      <Button href="/triagem/" variant="primary" class="text-xs px-5 py-2.5 shadow-md hover:shadow-lg transition-all duration-200">
        Inscreva-se
      </Button>
    </div>

    <!-- Mobile Hamburger Trigger -->
    <button
      id="mobile-menu-trigger"
      type="button"
      class="xl:hidden p-2 text-white hover:text-[#C1BDA6] focus-visible:outline-2 focus-visible:outline-[#D99B26] rounded transition-colors duration-200"
      aria-label="Abrir menu de navegação"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="mobile-menu-dialog"
    >
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Native HTML5 Dialog for Mobile Navigation -->
  <dialog
    id="mobile-menu-dialog"
    class="xl:hidden fixed inset-0 m-0 w-full h-full max-w-none max-h-none bg-[#1C2530] text-white p-6 border-0 backdrop:bg-black/80 backdrop:backdrop-blur-md"
    aria-label="Menu de navegação móvel"
  >
    <div class="flex flex-col h-full justify-between max-w-md mx-auto">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-[#3B4C60]/40">
          <div class="flex items-center">
            <img src="/images/PLM_Logo.png" alt="Pure Life Ministries Brasil" class="h-10 w-auto object-contain drop-shadow-[0_0_10px_rgba(255,255,255,0.2)]" />
          </div>
          <button
            id="mobile-menu-close"
            type="button"
            class="p-2 text-white hover:text-[#C1BDA6] focus-visible:outline-2 focus-visible:outline-[#D99B26] rounded transition-colors duration-200"
            aria-label="Fechar menu de navegação"
          >
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="py-8">
          <Navigation currentPath={currentPath} isMobile={true} />
        </div>
      </div>

      <div class="flex flex-col gap-4 pt-6 border-t border-[#3B4C60]/40 pb-8">
        <Button href="/triagem/" variant="primary" class="w-full text-center py-3 shadow-md">
          Obter Ajuda Confidencial
        </Button>
        <Button href="/doar/" variant="outline-light" class="w-full text-center py-3">
          Fazer uma Doação
        </Button>
      </div>
    </div>
  </dialog>
</header>

<script>
  import "./mobile-nav.ts";

  const header = document.getElementById("main-header");
  const headerContainer = document.getElementById("header-container");
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 20) {
        header.classList.add("nav-scrolled");
        if (headerContainer) {
          headerContainer.classList.remove("h-16", "sm:h-20");
          headerContainer.classList.add("h-14", "sm:h-16");
        }
      } else {
        header.classList.remove("nav-scrolled");
        if (headerContainer) {
          headerContainer.classList.add("h-16", "sm:h-20");
          headerContainer.classList.remove("h-14", "sm:h-16");
        }
      }
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }
</script>
