---
interface Props {
  currentPath?: string;
  isMobile?: boolean;
}

const { currentPath = "", isMobile = false } = Astro.props;

const navItems = [
  { href: "/", label: "Início" },
  { href: "/sobre/", label: "Sobre" },
  { href: "/programas/", label: "Programas" },
  { href: "/curso/", label: "Curso" },
  { href: "/editora/", label: "Editora" },
  { href: "/conferencia/", label: "Conferência" },
  { href: "/viagem-eua/", label: "Viagem EUA" },
  { href: "/perguntas-frequentes/", label: "Perguntas" },
];
---

<nav aria-label={isMobile ? "Navegação móvel" : "Navegação principal"}>
  <ul class={isMobile ? "flex flex-col gap-4 text-left" : "flex items-center gap-3 2xl:gap-5"}>
    {
      navItems.map((item) => {
        const isActive = item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
        return (
          <li>
            <a
              href={item.href}
              class={isMobile
                ? `font-montserrat text-sm uppercase tracking-wider block py-2 ${isActive ? "text-[#C1BDA6] font-bold" : "text-[#DEDEDE] hover:text-white"}`
                : `nav-link ${isActive ? "text-[#C1BDA6] font-bold" : ""}`}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
