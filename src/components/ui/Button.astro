---
interface Props {
  href?: string;
  variant?: "primary" | "dark" | "outline" | "outline-light";
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const variantClasses = {
  primary: "btn-primary",
  dark: "btn-dark",
  outline: "btn-outline",
  "outline-light": "btn-outline-light",
};

const baseClass = `${variantClasses[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={baseClass} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={baseClass} {...rest}>
      <slot />
    </button>
  )
}
