---
interface Props {
  tag?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  invert?: boolean;
  /** Nível do título. Use "h1" no primeiro título de cada página interna (uma única vez). */
  as?: "h1" | "h2";
}

const { tag, title, description, align = "left", invert = false, as: Tag = "h2" } = Astro.props;
---

<div class={`mb-12 ${align === "center" ? "text-center mx-auto max-w-3xl" : "max-w-2xl"}`}>
  {
    tag && (
      <span
        data-reveal="from-left"
        class={`font-montserrat text-xs font-bold tracking-[0.15em] uppercase block mb-3 ${
          invert ? "text-[#C1BDA6]" : "text-[#044A82]"
        }`}
      >
        {tag}
      </span>
    )
  }
  <Tag
    data-reveal
    class={`font-ruda font-black text-balance text-3xl sm:text-4xl lg:text-5xl leading-tight ${
      invert ? "text-white" : "text-[#1C2530]"
    }`}
  >
    {title}
  </Tag>
  {
    description && (
      <p
        data-reveal
        class={`font-montserrat text-base sm:text-lg leading-relaxed mt-4 ${
          invert ? "text-[#DEDEDE]" : "text-[#575757]"
        }`}
      >
        {description}
      </p>
    )
  }
</div>
