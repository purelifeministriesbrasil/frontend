---
export const prerender = true;

import ContentLayout from "../../layouts/ContentLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
---

<ContentLayout
  title="Solicitação Recebida | Pure Life Ministries Brasil"
  description="Sua solicitação confidencial foi recebida com sucesso por nossa equipe pastoral."
  canonical="https://purelifebrasil.org/triagem/recebido/"
  robots="noindex, nofollow"
  currentPath="/triagem/recebido/"
>
  <section class="py-24 bg-[#F5F2EC]">
    <Container size="narrow" class="text-center">
      <div class="bg-white border border-[#DEDEDE] p-8 sm:p-12 shadow-xs">
        <div class="w-16 h-16 bg-[#1D6F42] text-white rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h1 class="font-ruda font-bold text-2xl sm:text-3xl text-[#1C2530] mb-4">
          Solicitação Registrada com Sigilo
        </h1>
        <p class="font-montserrat text-[#575757] text-sm sm:text-base leading-relaxed mb-6">
          Sua mensagem foi recebida pela nossa equipe pastoral e criptografada com segurança institucional.
          Entraremos em contato através do canal indicado com discrição e respeito.
        </p>
        <Button href="/" variant="primary">
          Voltar à página inicial
        </Button>
      </div>
    </Container>
  </section>
</ContentLayout>
