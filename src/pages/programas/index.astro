---
export const prerender = true;

import ContentLayout from "../../layouts/ContentLayout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import ProgramCard from "../../components/programs/ProgramCard.astro";
import ProgramProcess from "../../components/programs/ProgramProcess.astro";
import { programs } from "../../data/programs";
---

<ContentLayout
  title="Programas de Aconselhamento | Pure Life Ministries Brasil"
  description="Programa Residencial, Online Vida Pura e Apoio para Esposas: modalidades de aconselhamento bíblico para restauração de homens e famílias."
  canonical="https://purelifeministriesbrasil.org/programas/"
  currentPath="/programas/"
>
  <section class="py-20 bg-[#1C2530] text-white">
    <Container size="wide">
      <SectionHeading
        tag="Aconselhamento Bíblico"
        title="Programas Estruturados para Restauração Genuína"
        description="Modalidades pensadas para atender homens e famílias com acompanhamento pastoral dedicado fundamentado na suficiência das Escrituras."
        invert={true}
      />
    </Container>
  </section>

  <section class="py-24 bg-[#F5F2EC]">
    <Container size="wide">
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 mb-20">
        {programs.map((program) => (
          <ProgramCard
            badge={program.badge}
            badgeVariant={program.badgeVariant}
            title={program.title}
            subtitle={program.subtitle}
            description={program.description}
            features={program.features}
            imageSrc={program.imageSrc}
            imageAlt={program.imageAlt}
            leaderName={program.leaderName}
            ctaText={program.ctaText}
            ctaHref={program.ctaHref}
            ctaExternal={program.ctaExternal}
            secondaryCtaText={program.secondaryCtaText}
            secondaryCtaHref={program.secondaryCtaHref}
          />
        ))}
      </div>

      <ProgramProcess />
    </Container>
  </section>
</ContentLayout>
