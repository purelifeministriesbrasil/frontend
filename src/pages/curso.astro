---
export const prerender = true;

import ContentLayout from "../layouts/ContentLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import CourseHighlight from "../components/course/CourseHighlight.astro";
import { siteConfig } from "../lib/site-config";

const { course, contact } = siteConfig;

const audience = [
  { title: "Pastores e líderes", desc: "Que precisam responder com sabedoria, graça e fundamento aos desafios da sexualidade na igreja." },
  { title: "Conselheiros bíblicos", desc: "Que desejam aprofundar o aconselhamento na área da sexualidade à luz das Escrituras." },
  { title: "Educadores e profissionais", desc: "Que querem compreender identidade, casamento e família a partir de uma cosmovisão bíblica." },
];

/** Temas da formação (divulgação oficial do curso). A grade completa é enviada pelo consultor. */
const themes = [
  "Teologia da Sexualidade",
  "Teologia do Casamento",
  "Aconselhamento Bíblico",
  "O impacto pessoal e social da pornografia",
  "Cosmovisões contemporâneas sobre gênero, identidade e sexualidade",
  "Transformação da mente e santificação",
];

const facts = [
  { label: "Curso", value: course.title },
  { label: "Certificação", value: course.institution },
  { label: "Duração", value: course.durationLabel },
  { label: "Modalidade", value: `${course.modalityLabel} (EAD)` },
  { label: "Corpo docente", value: "Professores experientes, incluindo o Pr. Paulo Gouvêa, referência em aconselhamento bíblico na área da sexualidade" },
  { label: "Chancela", value: "SEBI (Sociedade Bíblica de Estudos Interdisciplinares) + Pure Life Ministries" },
  { label: "Abordagem", value: "Interdisciplinar e comprometida com a autoridade das Escrituras" },
];
---

<ContentLayout
  title="Formação Superior em Sexualidade Humana sob Perspectiva Bíblica | Pure Life Ministries Brasil"
  description="Formação Superior Sequencial em Sexualidade Humana sob Perspectiva Bíblica, certificada pela Faculdade Coram Deo: teologia da sexualidade e do casamento, aconselhamento bíblico e cosmovisões contemporâneas."
  canonical="https://purelifeministriesbrasil.org/curso/"
  currentPath="/curso/"
>
  <CourseHighlight headingLevel="h1" />

  <section class="py-24 bg-[#F5F2EC]">
    <Container size="wide">
      <SectionHeading
        tag="Para quem é"
        title="Formação para quem está na linha de frente"
        description="A formação prepara servos de Cristo para acolher, aconselhar e acompanhar pessoas e famílias cativas pelo pecado sexual."
      />

      <div class="grid sm:grid-cols-3 gap-6" data-reveal-group>
        {audience.map((item) => (
          <div class="card-lift bg-white border border-[#DEDEDE] hover:border-[#044A82] p-8 transition-all duration-500" data-reveal>
            <h3 class="font-ruda font-bold text-lg text-[#044A82] mb-2">{item.title}</h3>
            <p class="font-montserrat text-[#575757] text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section id="grade" class="py-24 bg-white scroll-mt-24">
    <Container size="wide">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <SectionHeading
            tag="Grade e Estrutura"
            title="Informações do curso"
            description="Confira a estrutura da formação e os temas estudados. Investimento, datas da próxima turma e a grade completa são enviados pelo consultor acadêmico."
          />
          <Button
            href={contact.courseWhatsapp.url}
            variant="primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Solicitar grade completa
            <span class="sr-only"> (WhatsApp, abre em nova aba)</span>
          </Button>
          <p class="font-montserrat text-xs text-[#575757] mt-4">
            WhatsApp exclusivo do curso: {contact.courseWhatsapp.display}
          </p>
        </div>

        <div>
          <dl class="border border-[#DEDEDE] divide-y divide-[#DEDEDE] mb-10">
          {facts.map((fact) => (
            <div class="grid sm:grid-cols-3 gap-2 p-5">
              <dt class="font-montserrat text-xs uppercase font-bold tracking-widest text-[#044A82]">{fact.label}</dt>
              <dd class="sm:col-span-2 font-montserrat text-sm text-[#1C2530] leading-relaxed">{fact.value}</dd>
            </div>
          ))}
          </dl>

          <h3 class="font-ruda font-bold text-xl text-[#1C2530] mb-4">Temas da formação</h3>
          <ol class="space-y-3">
            {themes.map((theme, index) => (
              <li class="flex gap-4 border-l-2 border-[#D99B26] pl-4">
                <span class="font-ruda font-black text-[#044A82] shrink-0">{String(index + 1).padStart(2, "0")}</span>
                <span class="font-montserrat text-sm text-[#1C2530] leading-relaxed">{theme}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </Container>
  </section>
</ContentLayout>
