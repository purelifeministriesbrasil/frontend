---
export const prerender = true;

import ContentLayout from "../layouts/ContentLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ContactForm from "../components/forms/ContactForm";
---

<ContentLayout
  title="Fale Conosco | Pure Life Ministries Brasil"
  description="Entre em contato com nossa equipe pastoral para tirar dúvidas sobre programas, livros ou agendar atendimentos."
  canonical="https://purelifebrasil.org/contato/"
  currentPath="/contato/"
>
  <section class="py-20 bg-[#1C2530] text-white">
    <Container size="wide">
      <SectionHeading
        tag="Atendimento"
        title="Entre em Contato com Nossa Equipe"
        description="Estamos à disposição para prestar esclarecimentos, orientar sobre nossos programas e acolher sua família."
        invert={true}
      />
    </Container>
  </section>

  <section class="py-24 bg-[#F5F2EC]">
    <Container size="wide">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <span class="font-montserrat text-xs uppercase tracking-widest text-[#044A82] font-bold block mb-2">
            Canais de Comunicação
          </span>
          <h3 class="font-ruda font-bold text-2xl sm:text-3xl text-[#1C2530] mb-6">
            Orientações Pastorais e Informações Gerais
          </h3>
          <p class="font-montserrat text-[#575757] text-base leading-relaxed mb-8">
            Nossa equipe responde prontamente a contatos institucionais. Se você precisa de orientação urgente sobre avaliação residencial ou online, também pode iniciar diretamente a triagem confidencial.
          </p>

          <div class="space-y-4 mb-8">
            <div class="bg-white border border-[#DEDEDE] p-6 flex items-start gap-4">
              <div class="text-[#044A82] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div>
                <strong class="font-ruda font-bold text-[#1C2530] block">E-mail Institucional</strong>
                <span class="font-montserrat text-sm text-[#575757]">contato@purelifebrasil.org</span>
              </div>
            </div>

            <div class="bg-white border border-[#DEDEDE] p-6 flex items-start gap-4">
              <div class="text-[#044A82] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div>
                <strong class="font-ruda font-bold text-[#1C2530] block">Localização do Campus</strong>
                <span class="font-montserrat text-sm text-[#575757]">Águas Lindas de Goiás – GO (a 50 km de Brasília)</span>
              </div>
            </div>

            <div class="bg-white border border-[#DEDEDE] p-6 flex items-start gap-4">
              <div class="text-[#044A82] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
              <div>
                <strong class="font-ruda font-bold text-[#1C2530] block">Sigilo Pastoral</strong>
                <span class="font-montserrat text-sm text-[#575757]">Todas as comunicações são tratadas com discrição absoluta.</span>
              </div>
            </div>
          </div>
        </div>

        <ContactForm client:visible />
      </div>
    </Container>
  </section>
</ContentLayout>
