# ==============================================================================
# Pure Life Ministries Brasil — variáveis PÚBLICAS do frontend (template)
# ==============================================================================
# cp .env.example .env   (local)  •  Cloudflare Pages → Settings → Variables (produção)
# Tudo com prefixo PUBLIC_ vai embutido no HTML/JS gerado: NUNCA coloque segredos aqui.
# O frontend não fala com o Supabase: dados só trafegam pela API do Worker.

# Origem pública do site (canonical e links absolutos)
PUBLIC_SITE_ORIGIN=https://purelifebrasil.org

# Base da API (Cloudflare Worker). Também entra no CSP (connect-src/form-action) no build.
# Produção: https://api.purelifebrasil.org  •  Dev local com `wrangler dev`: http://localhost:8787
# Vazio = mesma origem (apenas se o Worker estiver roteado em purelifebrasil.org/api/*).
PUBLIC_API_URL=http://localhost:8787

# Cloudflare Turnstile — site key PÚBLICA do widget (a secret fica só no Worker).
# Chave de TESTE oficial (sempre aprova) para desenvolvimento:
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
