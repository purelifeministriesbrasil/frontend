{
  "name": "purelife-web",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node ./scripts/generate-csp.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "verify:topology": "node ./scripts/verify-topology.mjs",
    "verify:no-inline-style": "node ./scripts/verify-no-inline-style.mjs",
    "verify:dist-secrets": "node ./scripts/verify-dist-secrets.mjs",
    "ci:verify": "pnpm typecheck && pnpm build && pnpm verify:topology && pnpm verify:no-inline-style && pnpm verify:dist-secrets",
    "verify:pnpm": "node ./scripts/verify-package-manager.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "4.1.3",
    "@tailwindcss/vite": "^4.0.9",
    "lucide-preact": "1.57.0",
    "preact": "10.29.8",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "astro": "^7.4.8",
    "sharp": "0.34.5",
    "typescript": "^5.7.3"
  }
}
